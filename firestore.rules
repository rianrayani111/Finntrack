rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthed() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function myRole() {
      return userDoc(request.auth.uid).data.role;
    }

    function myParentId() {
      return userDoc(request.auth.uid).data.parentId;
    }

    function isParent() {
      return isAuthed() && myRole() == 'parent';
    }

    function isChild() {
      return isAuthed() && myRole() == 'child';
    }

    function noRoleChange() {
      return request.resource.data.role == resource.data.role;
    }

    match /users/{uid} {
      // Self-read allowed. Parent can read child docs where parentId matches.
      allow get, list: if isAuthed() && (
        request.auth.uid == uid ||
        (isParent() && resource.data.parentId == request.auth.uid)
      );

      // Parent signup can create its own user doc, child docs may be created by parent-owned backend paths.
      allow create: if isAuthed() && request.auth.uid == uid;

      // User can update own doc but cannot change role.
      allow update: if isAuthed() && request.auth.uid == uid && noRoleChange();

      allow delete: if false;
    }

    match /transactions/{id} {
      // Read: child sees own transactions, parent sees own family's transactions.
      allow get, list: if isAuthed() && (
        (isChild() && resource.data.childId == request.auth.uid) ||
        (isParent() && resource.data.parentId == request.auth.uid)
      );

      // Child may create ONLY own withdrawals tied to own parentId.
      allow create: if isChild() &&
        request.resource.data.childId == request.auth.uid &&
        request.resource.data.parentId == myParentId() &&
        request.resource.data.type == 'withdrawal' &&
        request.resource.data.createdBy == 'child' &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0;

      // Parent may create ONLY deposits tied to own uid.
      allow create: if isParent() &&
        request.resource.data.parentId == request.auth.uid &&
        request.resource.data.type == 'deposit' &&
        request.resource.data.createdBy == 'parent' &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0;

      // Parent may edit existing family transactions.
      allow update: if isParent() &&
        resource.data.parentId == request.auth.uid &&
        request.resource.data.parentId == request.auth.uid &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0;

      allow delete: if false;
    }

    match /goals/{id} {
      // Parent can view all family goals; child can view goals assigned to self.
      allow get, list: if isAuthed() && (
        (isParent() && resource.data.parentId == request.auth.uid) ||
        (isChild() && resource.data.childId == request.auth.uid)
      );

      // Parent can create goals only for children in their family.
      allow create: if isParent() &&
        request.resource.data.parentId == request.auth.uid &&
        request.resource.data.goalType in ['earn', 'save'] &&
        request.resource.data.targetAmount is number &&
        request.resource.data.targetAmount > 0;

      // Parent may update and delete only their own family goals.
      allow update, delete: if isParent() && resource.data.parentId == request.auth.uid;
    }

    match /alerts/{id} {
      // Only parent reads alerts for their family.
      allow get, list: if isParent() && resource.data.parentId == request.auth.uid;

      // Parent can update read state on their own alerts.
      allow update: if isParent() &&
        resource.data.parentId == request.auth.uid &&
        request.resource.data.parentId == resource.data.parentId &&
        request.resource.data.childId == resource.data.childId &&
        request.resource.data.transactionId == resource.data.transactionId;

      // Child can create alert only for self and own parent.
      allow create: if isChild() &&
        request.resource.data.childId == request.auth.uid &&
        request.resource.data.parentId == myParentId();

      allow delete: if false;
    }

    match /usernames/{username} {
      // Readable for availability checks.
      allow get, list: if true;

      // Only authenticated parent may reserve username, and only if not already taken.
      allow create: if isParent() &&
        !exists(/databases/$(database)/documents/usernames/$(username)) &&
        request.resource.data.parentId == request.auth.uid;

      allow update, delete: if false;
    }
  }
}
