{
  "name": "Goal",
  "type": "object",
  "properties": {
    "childId": {
      "type": "string",
      "description": "The child user uid this goal belongs to"
    },
    "goalType": {
      "type": "string",
      "enum": [
        "earn",
        "save"
      ],
      "description": "Whether this goal is based on earning or saving"
    },
    "title": {
      "type": "string",
      "description": "A short name for the goal"
    },
    "targetAmount": {
      "type": "number",
      "description": "Target amount required to complete this goal"
    },
    "startDate": {
      "type": "string",
      "format": "date",
      "description": "Goal timeline start date"
    },
    "endDate": {
      "type": "string",
      "format": "date",
      "description": "Goal timeline end date"
    },
    "reward": {
      "type": "string",
      "description": "Optional reward granted when the goal is completed"
    }
  },
  "required": [
    "childId",
    "goalType",
    "title",
    "targetAmount",
    "startDate",
    "endDate"
  ]
}
